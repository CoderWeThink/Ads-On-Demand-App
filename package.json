{
  "name": "ads-on-demand", "version": "0.3.0", "private": true,
  "description": "Ads on Demand Windows desktop application", "author": "Ads on Demand", "copyright": "Copyright © 2026 Ads on Demand",
  "main": "dist/main/main.js",
  "scripts": { "build": "tsc -p tsconfig.main.json && vite build", "check": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit", "start": "electron .", "portable": "pnpm build && electron-builder --win portable --x64 --publish never", "installer": "pnpm build && electron-builder --win nsis --x64 --publish never", "package:windows": "pnpm build && electron-builder --win nsis portable --x64 --publish never" },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0", "lucide-react": "^0.468.0" },
  "devDependencies": { "electron": "44.4.1", "electron-builder": "26.15.3", "typescript": "^5.9.3", "vite": "8.3.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@types/node": "^24.0.0" },
  "build": {
    "appId": "com.adsondemand.desktop",
    "productName": "Ads on Demand",
    "executableName": "Ads on Demand",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "package.json"],
    "extraResources": [
      { "from": "build/icon.ico", "to": "branding/icon.ico" },
      { "from": "build/tray-icon.png", "to": "branding/tray-icon.png" }
    ],
    "asar": true,
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico", "signExecutable": false },
    "nsis": { "artifactName": "Ads-on-Demand-Setup.exe", "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": "always", "createStartMenuShortcut": true, "shortcutName": "Ads on Demand", "deleteAppDataOnUninstall": false },
    "portable": { "artifactName": "Ads-on-Demand-Portable.exe" }
  }
}

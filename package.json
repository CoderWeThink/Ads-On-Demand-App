{
  "name": "ads-on-demand", "version": "0.1.1", "private": true,
  "description": "Ads on Demand Windows welcome screen", "author": "Ads on Demand",
  "main": "dist/main/main.js",
  "scripts": { "build": "tsc -p tsconfig.main.json && vite build", "check": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit", "start": "electron .", "portable": "pnpm build && electron-builder --win portable --x64" },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0", "lucide-react": "^0.468.0" },
  "devDependencies": { "electron": "44.4.1", "electron-builder": "26.15.3", "typescript": "^5.9.3", "vite": "8.3.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@types/node": "^24.0.0" },
  "build": { "appId": "com.adsondemand.desktop", "productName": "Ads on Demand", "directories": { "output": "release" }, "files": ["dist/**/*", "package.json"], "asar": true, "win": { "target": "portable", "signAndEditExecutable": false }, "portable": { "artifactName": "Ads-on-Demand.exe" } }
}
